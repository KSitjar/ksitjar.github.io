---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceList from "../components/ExperienceList.astro";
import MetricGrid from "../components/MetricGrid.astro";
import {
  certifications,
  competencies,
  education,
  experience,
  keyResults,
  resumeSummary,
} from "../data/resume";
import { profile } from "../data/profile";
---

<BaseLayout
  title="Resume"
  description="Resume for Kenneth Sitjar, digital product manager focused on fintech onboarding, product strategy, experimentation, and trusted digital delivery."
>
  <section class="container page-hero resume-hero">
    <div>
      <p class="eyebrow">Resume</p>
      <h1>Kenneth Sitjar, digital product manager.</h1>
      <p>{resumeSummary.body}</p>
      <div class="button-row">
        <a class="button primary" href={`mailto:${profile.email}`}>Contact Kenneth Sitjar</a>
      </div>
    </div>
    <aside class="card resume-snapshot" aria-label="Kenneth Sitjar at a glance">
      <p class="eyebrow">At a glance</p>
      <dl>
        <div>
          <dt>Current lane</dt>
          <dd>Digital onboarding and fintech product delivery</dd>
        </div>
        <div>
          <dt>Strengths</dt>
          <dd>Roadmaps, experiments, APIs, compliance, and cross-functional execution</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.location}</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="container page-section">
    <MetricGrid metrics={keyResults} />
  </section>

  <section class="page-section">
    <div class="container resume-columns">
      <aside class="resume-column">
        <h2>Core Competencies</h2>
        <div class="card resume-aside">
          <ul class="check-list competency-list">
            {competencies.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </aside>
      <div class="resume-column">
        <h2>Professional Experience</h2>
        <ExperienceList items={experience} />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container grid two">
      <article class="card">
        <h2>Education</h2>
        {
          education.map((item) => (
            <div class="credential">
              <h3>{item.credential}</h3>
              <p>{item.institution}</p>
            </div>
          ))
        }
      </article>
      <article class="card">
        <h2>Certifications</h2>
        <ul class="check-list">
          {certifications.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.65fr);
    align-items: stretch;
    gap: clamp(1.5rem, 5vw, 3rem);
  }

  .resume-hero h1 {
    max-width: 11ch;
  }

  .resume-snapshot {
    align-self: center;
  }

  .resume-snapshot dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .resume-snapshot div {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .resume-snapshot dt {
    color: var(--brand-deep);
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-snapshot dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .resume-columns {
    display: grid;
    grid-template-columns: minmax(280px, 0.62fr) minmax(0, 1.38fr);
    align-items: start;
    gap: clamp(1.5rem, 5vw, 3rem);
  }

  .resume-column {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .resume-aside {
    position: sticky;
    top: 96px;
  }

  .competency-list {
    gap: 0.85rem;
  }

  h2 {
    margin: 0;
    letter-spacing: -0.04em;
  }

  .credential h3 {
    margin-bottom: 0.2rem;
  }

  .credential p {
    margin-top: 0;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .resume-hero,
    .resume-columns {
      grid-template-columns: 1fr;
    }

    .resume-aside {
      position: static;
    }
  }
</style>
