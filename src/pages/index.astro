---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardIcon from "../components/CardIcon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import WritingCard from "../components/WritingCard.astro";
import { profile } from "../data/profile";
import { getSubstackPosts } from "../lib/substack";

const latestPosts = await getSubstackPosts(3);
---

<BaseLayout>
  <section class="container hero">
    <div>
      <p class="eyebrow">Digital Product Manager</p>
      <h1>Hi, I'm Kenneth Sitjar.</h1>
      <p>
        {profile.intro}
      </p>
      <div class="button-row">
        <a class="button primary" href="/resume/">View Kenneth's resume</a>
        <a class="button secondary" href={profile.newsletterUrl}>Read the newsletter</a>
      </div>
    </div>
    <aside class="hero-card" aria-label="Product leadership focus">
      <p class="eyebrow">Product focus</p>
      <h2>Digital product work with measurable progress.</h2>
      <p>
        My work sits where customer experience, compliance, risk, delivery, and data
        all have to line up before a product can earn trust.
      </p>
      <ul class="signal-list">
        <li>Digital onboarding and acquisition funnels</li>
        <li>API-first productization and integration strategy</li>
        <li>Experimentation, metrics, and cross-functional execution</li>
      </ul>
    </aside>
  </section>

  <section class="section alt">
    <div class="container">
      <SectionHeading
        eyebrow="The value behind the work"
        title="Product leadership that makes digital experiences easier to trust."
        description="The numbers live on the resume. Here, the point is the kind of value I try to create for customers, teams, and the business."
      />
      <div class="grid three">
        <article class="card value-card">
          <div class="card-title-row">
            <CardIcon name="friction" />
            <h3>Less friction</h3>
          </div>
          <p>
            I look for the moments where customers slow down, drop off, or lose confidence,
            then help teams make those paths clearer and easier to complete.
          </p>
        </article>
        <article class="card value-card">
          <div class="card-title-row">
            <CardIcon name="decisions" />
            <h3>Better decisions</h3>
          </div>
          <p>
            I use data, experiments, and customer signals to move conversations away from
            opinion and toward choices teams can explain.
          </p>
        </article>
        <article class="card value-card">
          <div class="card-title-row">
            <CardIcon name="delivery" />
            <h3>Trustworthy delivery</h3>
          </div>
          <p>
            I care about shipping, but I care just as much about the compliance, security,
            risk, and operational details that make a product durable.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Start here</p>
        <h2>Choose the path that fits why you're here.</h2>
      </div>
      <div class="grid two">
        <article class="card">
          <div class="card-title-row">
            <CardIcon name="article" />
            <h3>Professional background</h3>
          </div>
          <p>
            See the product roles, measurable outcomes, competencies, education, and
            certifications behind my work.
          </p>
          <a class="text-link" href="/resume/">View resume</a>
        </article>
        <article class="card">
          <div class="card-title-row">
            <CardIcon name="person" />
            <h3>How I think</h3>
          </div>
          <p>
            Read more about my perspective on product work, AI, privacy, and building
            useful digital experiences.
          </p>
          <a class="text-link" href="/about/">Learn about Kenneth</a>
        </article>
        <article class="card">
          <div class="card-title-row">
            <CardIcon name="newsletter" />
            <h3>Latest ideas</h3>
          </div>
          <p>
            Follow the newsletter for notes on product management, local AI, privacy,
            and the changing craft of delivery.
          </p>
          <a class="text-link" href={profile.newsletterUrl}>Read the newsletter</a>
        </article>
        <article class="card">
          <div class="card-title-row">
            <CardIcon name="contact" />
            <h3>Contact</h3>
          </div>
          <p>
            Reach out if you want to talk product leadership, onboarding, trusted
            growth, or practical AI workflows.
          </p>
          <a class="text-link" href={`mailto:${profile.email}`}>Email Kenneth</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Latest writing"
        title="Latest Writing"
        description="My writing on digital product management, privacy, local AI, and the tools changing how product teams work."
      />
      <div class="grid three">
        {latestPosts.map((post) => <WritingCard post={post} />)}
      </div>
      <div class="button-row section-action">
        <a class="button primary" href={profile.newsletterUrl}>Read the newsletter</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta">
      <p class="eyebrow">Work together</p>
      <h2>Need a product partner who can balance growth, delivery, and trust?</h2>
      <p>
        I bring product judgment, technical context, and a calm operating style to
        teams building digital experiences that have to perform in the real world.
      </p>
      <div class="button-row">
        <a class="button primary" href={`mailto:${profile.email}`}>Get in touch</a>
        <a class="button secondary" href="/about/">Learn more</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-action {
    margin-top: 1.5rem;
  }

  .split h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .card h3 {
    margin-top: 0;
  }

  .value-card p {
    margin-bottom: 0;
    color: var(--muted);
  }
</style>
