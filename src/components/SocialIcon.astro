---
type Props = {
  name: string;
  label: string;
};

const { name, label } = Astro.props;
const normalizedName = name.toLowerCase();
---

{
  normalizedName === "email" && (
    <svg role="img" aria-label={label} viewBox="0 0 24 24">
      <title>{label}</title>
      <path d="M3.75 5.75h16.5v12.5H3.75V5.75Zm1.8 1.7 6.45 5.02 6.45-5.02H5.55Zm12.9 9.1V9.72l-6.45 5.02-6.45-5.02v6.83h12.9Z" />
    </svg>
  )
}

{
  normalizedName === "linkedin" && (
    <svg role="img" aria-label={label} viewBox="0 0 24 24">
      <title>{label}</title>
      <path d="M5.15 8.72h3.22v10.13H5.15V8.72Zm1.62-4.95c1.03 0 1.87.78 1.87 1.78 0 .98-.84 1.77-1.87 1.77S4.9 6.53 4.9 5.55c0-1 .84-1.78 1.87-1.78Zm3.6 4.95h3.08v1.39h.04c.43-.8 1.48-1.64 3.04-1.64 3.25 0 3.85 2.04 3.85 4.7v5.68h-3.21v-5.04c0-1.2-.03-2.75-1.76-2.75-1.77 0-2.04 1.31-2.04 2.66v5.13h-3.21V8.72Z" />
