---
import type { Experience } from "../data/resume";

type Props = {
  items: Experience[];
};

const { items } = Astro.props;
---

<div class="experience-list">
  {
    items.map((item) => (
      <article class="card experience-card">
        <div>
          <p class="eyebrow">{item.period}</p>
          <h3>{item.role}</h3>
          <p class="experience-meta">{item.company}</p>
        </div>
        <div>
          <p>{item.summary}</p>
          <ul class="check-list">
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </div>
      </article>
    ))
  }
</div>
